generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  SKILLED_PROVIDER
  LABOURER
  CONTRACTOR
  MATERIAL_SUPPLIER
  ADMIN
  ONBOARDING_PENDING
}

enum AccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
  DEACTIVATED
}

enum VerificationStatus {
  UNVERIFIED
  PHONE_VERIFIED
  IDENTITY_VERIFIED
  BUSINESS_VERIFIED
  YARTONG_VERIFIED
}

enum JobStatus {
  DRAFT
  PUBLISHED
  CLOSED
  CANCELLED
}

enum JobUrgency {
  STANDARD
  WITHIN_24_HOURS
  EMERGENCY
}

enum JobBudgetType {
  FIXED
  RANGE
  NEGOTIABLE
}

enum JobProviderRole {
  SKILLED_PROVIDER
  LABOURER
  CONTRACTOR
}

enum ApplicationStatus {
  SUBMITTED
  SHORTLISTED
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum EngagementStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DISPUTED
}

enum ReviewStatus {
  PUBLISHED
  FLAGGED
  HIDDEN
}

enum VerificationRequestType {
  IDENTITY
  BUSINESS
  PROFESSIONAL_CREDENTIAL
}

enum VerificationRequestStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  CANCELLED
}

enum QuoteStatus {
  SUBMITTED
  ACCEPTED
  REJECTED
  WITHDRAWN
  SUPERSEDED
}

enum PaymentStatus {
  CREATED
  PENDING
  REQUIRES_ACTION
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum PaymentEventStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

enum DisputeStatus {
  OPEN
  AWAITING_RESPONSE
  UNDER_REVIEW
  RESOLVED
  CANCELLED
}

enum DisputeCategory {
  WORK_QUALITY
  INCOMPLETE_WORK
  NO_SHOW
  DELAY
  SCOPE_DISAGREEMENT
  PAYMENT
  PROPERTY_DAMAGE
  SAFETY
  HARASSMENT
  FRAUD
  OTHER
}

enum DisputeResolution {
  NO_ACTION
  MUTUAL_AGREEMENT
  REDO_WORK
  PARTIAL_REFUND_RECOMMENDED
  FULL_REFUND_RECOMMENDED
  PAYMENT_RELEASE_RECOMMENDED
  ACCOUNT_ACTION
  OTHER
}

enum DisputeEventKind {
  SYSTEM
  STATEMENT
  ADMIN_NOTE
  STATUS_CHANGE
  RESOLUTION
}

enum DisputeEventVisibility {
  PARTICIPANTS
  ADMIN_ONLY
}

enum CatalogProductStatus {
  ACTIVE
  PENDING_REVIEW
  MERGED
  ARCHIVED
}

enum CatalogProductSource {
  ADMIN_CURATED
  SUPPLIER_SUBMITTED
  IMPORTED
}

enum CatalogVariantStatus {
  ACTIVE
  ARCHIVED
}

enum SupplierListingStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum InventoryMovementType {
  RESTOCK
  SALE
  RESERVE
  RELEASE
  RETURN
  DAMAGE
  ADJUSTMENT
}

enum MaterialOrderStatus {
  PLACED
  ACCEPTED
  REJECTED
  PREPARING
  READY
  FULFILLED
  CANCELLED
}

enum MaterialFulfillmentMethod {
  PICKUP
  DELIVERY
}

enum MaterialOrderEventType {
  PLACED
  ACCEPTED
  REJECTED
  PREPARING
  READY
  FULFILLED
  CANCELLED
  NOTE
}

enum NotificationType {
  ORDER
  DISPUTE
  MESSAGE
  ENGAGEMENT
  APPLICATION
  VERIFICATION
  PAYMENT
  SYSTEM
}

model User {
  id                 String             @id @default(cuid())
  displayName        String             @default("")
  name               String?
  email              String?            @unique
  emailVerified      DateTime?
  phoneNumber        String?            @unique
  image              String?
  primaryRole        UserRole           @default(ONBOARDING_PENDING)
  accountStatus      AccountStatus      @default(ACTIVE)
  verificationStatus VerificationStatus @default(UNVERIFIED)
  primaryLocationId  String?
  primaryLocation    Location?          @relation(fields: [primaryLocationId], references: [id], onDelete: SetNull)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  lastActiveAt       DateTime?
  isDemo             Boolean            @default(false)

  accounts                      Account[]
  sessions                      Session[]
  customerProfile               CustomerProfile?
  skilledProviderProfile        SkilledProviderProfile?
  labourerProfile               LabourerProfile?
  contractorProfile             ContractorProfile?
  materialSupplierProfile       MaterialSupplierProfile?
  jobs                          Job[]
  jobApplications               JobApplication[]         @relation("ApplicationProvider")
  customerEngagements           Engagement[]             @relation("EngagementCustomer")
  providerEngagements           Engagement[]             @relation("EngagementProvider")
  customerConversations         Conversation[]           @relation("ConversationCustomer")
  providerConversations         Conversation[]           @relation("ConversationProvider")
  sentMessages                  Message[]                @relation("MessageSender")
  authoredReviews               Review[]                 @relation("ReviewAuthor")
  receivedReviews               Review[]                 @relation("ReviewSubject")
  verificationRequests          VerificationRequest[]    @relation("VerificationApplicant")
  reviewedVerifications         VerificationRequest[]    @relation("VerificationReviewer")
  createdQuotes                 EngagementQuote[]        @relation("QuoteCreator")
  customerPaymentOrders         PaymentOrder[]           @relation("PaymentCustomer")
  providerPaymentOrders         PaymentOrder[]           @relation("PaymentProvider")
  openedDisputes                Dispute[]                @relation("DisputeOpenedBy")
  assignedDisputes              Dispute[]                @relation("DisputeAssignedAdmin")
  disputeEvents                 DisputeEvent[]           @relation("DisputeEventActor")
  createdCatalogProducts        CatalogProduct[]         @relation("CatalogProductCreator")
  supplierListings              SupplierListing[]        @relation("SupplierListingSupplier")
  supplierInventoryLocations    InventoryLocation[]      @relation("InventoryLocationSupplier")
  inventoryMovements            InventoryMovement[]      @relation("InventoryMovementActor")
  customerMaterialOrders        MaterialOrder[]          @relation("MaterialOrderCustomer")
  supplierMaterialOrders        MaterialOrder[]          @relation("MaterialOrderSupplier")
  materialOrderEvents           MaterialOrderEvent[]     @relation("MaterialOrderEventActor")
  notifications                 Notification[]
  customerMaterialPaymentOrders MaterialPaymentOrder[]   @relation("MaterialPaymentCustomer")
  supplierMaterialPaymentOrders MaterialPaymentOrder[]   @relation("MaterialPaymentSupplier")
  catalogModerationEvents       CatalogModerationEvent[] @relation("CatalogModerationActor")

  @@index([primaryRole])
  @@index([accountStatus])
  @@index([primaryLocationId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Location {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  district  String
  state     String
  country   String   @default("India")
  pincode   String?
  latitude  Decimal? @db.Decimal(9, 6)
  longitude Decimal? @db.Decimal(9, 6)
  isActive  Boolean  @default(true)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  primaryUsers       User[]
  jobs               Job[]
  inventoryLocations InventoryLocation[]

  @@index([district, state, country])
  @@index([isActive])
}

model CustomerProfile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  onboardingComplete Boolean  @default(false)
  bio                String?  @db.VarChar(500)
  preferredLanguages String[] @default([])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SkilledProviderProfile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  onboardingComplete Boolean  @default(false)
  businessName       String?
  headline           String?
  bio                String?  @db.VarChar(800)
  experienceYears    Int?
  skills             String[] @default([])
  serviceRadiusKm    Int?
  availableForWork   Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LabourerProfile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  onboardingComplete Boolean  @default(false)
  headline           String?
  bio                String?  @db.VarChar(500)
  experienceYears    Int?
  skills             String[] @default([])
  availableForWork   Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ContractorProfile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  onboardingComplete Boolean  @default(false)
  businessName       String?
  headline           String?
  bio                String?  @db.VarChar(800)
  experienceYears    Int?
  teamSize           Int?
  projectTypes       String[] @default([])
  serviceRadiusKm    Int?
  availableForWork   Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MaterialSupplierProfile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  onboardingComplete Boolean  @default(false)
  businessName       String?
  headline           String?
  bio                String?  @db.VarChar(800)
  materialCategories String[] @default([])
  deliveryAvailable  Boolean  @default(false)
  deliveryRadiusKm   Int?
  wholesaleAvailable Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Job {
  id                  String            @id @default(cuid())
  customerId          String
  locationId          String
  title               String            @db.VarChar(120)
  description         String            @db.Text
  category            String            @db.VarChar(120)
  skills              String[]          @default([])
  targetProviderRoles JobProviderRole[] @default([])
  budgetType          JobBudgetType
  budgetMin           Int?
  budgetMax           Int?
  currency            String            @default("INR") @db.VarChar(3)
  urgency             JobUrgency        @default(STANDARD)
  preferredStartDate  DateTime?
  status              JobStatus         @default(DRAFT)
  publishedAt         DateTime?
  closedAt            DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  customer     User             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  location     Location         @relation(fields: [locationId], references: [id], onDelete: Restrict)
  applications JobApplication[]
  engagement   Engagement?

  @@index([customerId])
  @@index([locationId])
  @@index([status])
  @@index([publishedAt])
  @@index([status, publishedAt])
}

model JobApplication {
  id                   String            @id @default(cuid())
  jobId                String
  providerId           String
  providerRole         JobProviderRole
  message              String            @db.VarChar(2000)
  proposedPrice        Int?
  proposedTimelineDays Int?
  status               ApplicationStatus @default(SUBMITTED)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  job        Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  provider   User        @relation("ApplicationProvider", fields: [providerId], references: [id], onDelete: Cascade)
  engagement Engagement?

  @@unique([jobId, providerId])
  @@index([jobId, status])
  @@index([providerId, status])
}

model Engagement {
  id                   String           @id @default(cuid())
  jobId                String           @unique
  applicationId        String           @unique
  customerId           String
  providerId           String
  providerRole         JobProviderRole
  scope                String           @db.Text
  agreedPrice          Int?
  currency             String           @default("INR") @db.VarChar(3)
  proposedTimelineDays Int?
  status               EngagementStatus @default(PENDING)
  confirmedAt          DateTime?
  startedAt            DateTime?
  completedAt          DateTime?
  cancelledAt          DateTime?
  disputedAt           DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  job          Job               @relation(fields: [jobId], references: [id], onDelete: Restrict)
  application  JobApplication    @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  customer     User              @relation("EngagementCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  provider     User              @relation("EngagementProvider", fields: [providerId], references: [id], onDelete: Restrict)
  conversation Conversation?
  reviews      Review[]
  quotes       EngagementQuote[]
  paymentOrder PaymentOrder?
  dispute      Dispute?

  @@index([customerId, status])
  @@index([providerId, status])
  @@index([status, createdAt])
}

model Conversation {
  id            String   @id @default(cuid())
  engagementId  String   @unique
  customerId    String
  providerId    String
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  engagement Engagement @relation(fields: [engagementId], references: [id], onDelete: Restrict)
  customer   User       @relation("ConversationCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  provider   User       @relation("ConversationProvider", fields: [providerId], references: [id], onDelete: Restrict)
  messages   Message[]

  @@index([customerId, lastMessageAt])
  @@index([providerId, lastMessageAt])
}

model Message {
  id             String    @id @default(cuid())
  conversationId String
  senderId       String
  body           String    @db.VarChar(4000)
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Restrict)

  @@index([conversationId, createdAt])
  @@index([senderId, createdAt])
}

model Review {
  id           String       @id @default(cuid())
  engagementId String
  authorId     String
  subjectId    String
  rating       Int
  title        String?      @db.VarChar(120)
  comment      String?      @db.VarChar(3000)
  status       ReviewStatus @default(PUBLISHED)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  engagement Engagement @relation(fields: [engagementId], references: [id], onDelete: Restrict)
  author     User       @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  subject    User       @relation("ReviewSubject", fields: [subjectId], references: [id], onDelete: Restrict)

  @@unique([engagementId, authorId])
  @@index([subjectId, status, createdAt])
  @@index([authorId, createdAt])
}

model VerificationRequest {
  id            String                    @id @default(cuid())
  userId        String
  type          VerificationRequestType
  status        VerificationRequestStatus @default(SUBMITTED)
  applicantNote String?                   @db.VarChar(2000)
  reviewerId    String?
  reviewerNote  String?                   @db.VarChar(2000)
  providerName  String?                   @db.VarChar(120)
  providerRef   String?                   @db.VarChar(255)
  submittedAt   DateTime                  @default(now())
  reviewedAt    DateTime?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  applicant User  @relation("VerificationApplicant", fields: [userId], references: [id], onDelete: Cascade)
  reviewer  User? @relation("VerificationReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([userId, status, createdAt])
  @@index([status, type, submittedAt])
  @@index([reviewerId, reviewedAt])
}

model EngagementQuote {
  id           String      @id @default(cuid())
  engagementId String
  createdById  String
  amount       Int
  currency     String      @default("INR") @db.VarChar(3)
  scope        String      @db.Text
  timelineDays Int?
  note         String?     @db.VarChar(2000)
  status       QuoteStatus @default(SUBMITTED)
  submittedAt  DateTime    @default(now())
  respondedAt  DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  engagement Engagement @relation(fields: [engagementId], references: [id], onDelete: Restrict)
  createdBy  User       @relation("QuoteCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([engagementId, status, submittedAt])
  @@index([createdById, createdAt])
}

model PaymentOrder {
  id                 String        @id @default(cuid())
  engagementId       String        @unique
  customerId         String
  providerId         String
  amount             Int
  currency           String        @default("INR") @db.VarChar(3)
  status             PaymentStatus @default(CREATED)
  providerName       String?       @db.VarChar(80)
  providerPaymentRef String?       @db.VarChar(255)
  idempotencyKey     String        @unique @db.VarChar(255)
  failureCode        String?       @db.VarChar(120)
  failureMessage     String?       @db.VarChar(1000)
  authorizedAt       DateTime?
  paidAt             DateTime?
  cancelledAt        DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  engagement Engagement     @relation(fields: [engagementId], references: [id], onDelete: Restrict)
  customer   User           @relation("PaymentCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  provider   User           @relation("PaymentProvider", fields: [providerId], references: [id], onDelete: Restrict)
  events     PaymentEvent[]

  @@index([customerId, status, createdAt])
  @@index([providerId, status, createdAt])
  @@index([status, createdAt])
}

model PaymentEvent {
  id              String             @id @default(cuid())
  paymentOrderId  String?
  providerName    String             @db.VarChar(80)
  providerEventId String             @db.VarChar(255)
  eventType       String             @db.VarChar(160)
  status          PaymentEventStatus @default(RECEIVED)
  payload         Json
  errorMessage    String?            @db.VarChar(1000)
  receivedAt      DateTime           @default(now())
  processedAt     DateTime?
  createdAt       DateTime           @default(now())

  paymentOrder PaymentOrder? @relation(fields: [paymentOrderId], references: [id], onDelete: SetNull)

  @@unique([providerName, providerEventId])
  @@index([paymentOrderId, receivedAt])
  @@index([status, receivedAt])
}

model Dispute {
  id                       String             @id
  engagementId             String             @unique
  openedById               String
  assignedAdminId          String?
  category                 DisputeCategory
  title                    String             @db.VarChar(160)
  description              String             @db.Text
  desiredOutcome           String?            @db.VarChar(2000)
  status                   DisputeStatus      @default(OPEN)
  previousEngagementStatus EngagementStatus
  resolution               DisputeResolution?
  resolutionNote           String?            @db.VarChar(4000)
  recommendedRefundAmount  Int?
  openedAt                 DateTime           @default(now())
  reviewStartedAt          DateTime?
  resolvedAt               DateTime?
  cancelledAt              DateTime?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @default(now()) @updatedAt

  engagement    Engagement     @relation(fields: [engagementId], references: [id], onDelete: Restrict)
  openedBy      User           @relation("DisputeOpenedBy", fields: [openedById], references: [id], onDelete: Restrict)
  assignedAdmin User?          @relation("DisputeAssignedAdmin", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  events        DisputeEvent[]

  @@index([status, openedAt])
  @@index([openedById, createdAt])
  @@index([assignedAdminId, updatedAt])
}

model DisputeEvent {
  id         String                 @id
  disputeId  String
  actorId    String?
  kind       DisputeEventKind
  visibility DisputeEventVisibility @default(PARTICIPANTS)
  body       String                 @db.VarChar(4000)
  createdAt  DateTime               @default(now())

  dispute Dispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  actor   User?   @relation("DisputeEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([disputeId, createdAt])
  @@index([actorId, createdAt])
}

model CatalogCategory {
  id          String   @id
  parentId    String?
  slug        String   @unique
  name        String   @db.VarChar(120)
  description String?  @db.VarChar(1000)
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  parent   CatalogCategory?  @relation("CatalogCategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children CatalogCategory[] @relation("CatalogCategoryHierarchy")
  products CatalogProduct[]

  @@index([parentId, sortOrder])
  @@index([isActive, name])
}

model CatalogBrand {
  id          String   @id
  slug        String   @unique
  name        String   @db.VarChar(160)
  websiteUrl  String?  @db.VarChar(500)
  countryCode String?  @db.VarChar(2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  products CatalogProduct[]

  @@index([name])
}

model CatalogProduct {
  id                     String               @id
  categoryId             String
  brandId                String?
  createdBySupplierId    String?
  slug                   String               @unique
  name                   String               @db.VarChar(240)
  description            String?              @db.Text
  manufacturerPartNumber String?              @db.VarChar(160)
  attributes             Json                 @default("{}")
  status                 CatalogProductStatus @default(ACTIVE)
  source                 CatalogProductSource @default(SUPPLIER_SUBMITTED)
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @default(now()) @updatedAt

  category          CatalogCategory          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand             CatalogBrand?            @relation(fields: [brandId], references: [id], onDelete: SetNull)
  createdBySupplier User?                    @relation("CatalogProductCreator", fields: [createdBySupplierId], references: [id], onDelete: SetNull)
  variants          CatalogVariant[]
  moderationEvents  CatalogModerationEvent[] @relation("CatalogModerationProduct")
  moderationTargets CatalogModerationEvent[] @relation("CatalogModerationTarget")

  @@index([categoryId, status, name])
  @@index([brandId, status])
  @@index([createdBySupplierId, createdAt])
}

model CatalogVariant {
  id           String               @id
  productId    String
  sku          String               @unique @db.VarChar(160)
  name         String               @db.VarChar(240)
  gtin         String?              @db.VarChar(32)
  unitName     String               @db.VarChar(80)
  unitQuantity Decimal              @default(1) @db.Decimal(18, 3)
  attributes   Json                 @default("{}")
  status       CatalogVariantStatus @default(ACTIVE)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @default(now()) @updatedAt

  product  CatalogProduct    @relation(fields: [productId], references: [id], onDelete: Restrict)
  listings SupplierListing[]

  @@index([productId, status])
}

model SupplierListing {
  id                String                @id
  supplierId        String
  variantId         String
  sellerSku         String                @db.VarChar(160)
  title             String?               @db.VarChar(260)
  description       String?               @db.VarChar(3000)
  currency          String                @default("INR") @db.VarChar(3)
  price             Int
  minOrderQty       Decimal               @default(1) @db.Decimal(18, 3)
  deliveryAvailable Boolean               @default(false)
  leadTimeDays      Int?
  status            SupplierListingStatus @default(ACTIVE)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @default(now()) @updatedAt

  supplier   User                @relation("SupplierListingSupplier", fields: [supplierId], references: [id], onDelete: Restrict)
  variant    CatalogVariant      @relation(fields: [variantId], references: [id], onDelete: Restrict)
  stocks     InventoryStock[]
  orderItems MaterialOrderItem[]

  @@unique([supplierId, sellerSku])
  @@unique([supplierId, variantId])
  @@index([variantId, status, price])
  @@index([supplierId, status, updatedAt])
}

model InventoryLocation {
  id          String   @id
  supplierId  String
  locationId  String?
  name        String   @db.VarChar(160)
  addressLine String?  @db.VarChar(500)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  supplier       User             @relation("InventoryLocationSupplier", fields: [supplierId], references: [id], onDelete: Restrict)
  location       Location?        @relation(fields: [locationId], references: [id], onDelete: SetNull)
  stocks         InventoryStock[]
  materialOrders MaterialOrder[]

  @@unique([supplierId, name])
  @@index([supplierId, isActive])
}

model InventoryStock {
  id                  String   @id
  listingId           String
  inventoryLocationId String
  onHand              Decimal  @default(0) @db.Decimal(18, 3)
  reserved            Decimal  @default(0) @db.Decimal(18, 3)
  reorderPoint        Decimal? @db.Decimal(18, 3)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now()) @updatedAt

  listing           SupplierListing     @relation(fields: [listingId], references: [id], onDelete: Cascade)
  inventoryLocation InventoryLocation   @relation(fields: [inventoryLocationId], references: [id], onDelete: Restrict)
  movements         InventoryMovement[]
  orderItems        MaterialOrderItem[]

  @@unique([listingId, inventoryLocationId])
  @@index([inventoryLocationId, updatedAt])
}

model InventoryMovement {
  id            String                @id
  stockId       String
  actorId       String?
  type          InventoryMovementType
  onHandDelta   Decimal               @default(0) @db.Decimal(18, 3)
  reservedDelta Decimal               @default(0) @db.Decimal(18, 3)
  reason        String?               @db.VarChar(1000)
  reference     String?               @db.VarChar(255)
  createdAt     DateTime              @default(now())

  stock InventoryStock @relation(fields: [stockId], references: [id], onDelete: Cascade)
  actor User?          @relation("InventoryMovementActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([stockId, createdAt])
  @@index([actorId, createdAt])
}

model MaterialOrder {
  id                  String                    @id
  orderNumber         String                    @unique @db.VarChar(32)
  customerId          String
  supplierId          String
  inventoryLocationId String
  status              MaterialOrderStatus       @default(PLACED)
  fulfillmentMethod   MaterialFulfillmentMethod
  deliveryAddress     String?                   @db.VarChar(700)
  customerNote        String?                   @db.VarChar(2000)
  supplierNote        String?                   @db.VarChar(2000)
  currency            String                    @default("INR") @db.VarChar(3)
  subtotal            Int
  placedAt            DateTime                  @default(now())
  acceptedAt          DateTime?
  readyAt             DateTime?
  fulfilledAt         DateTime?
  cancelledAt         DateTime?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @default(now()) @updatedAt

  customer          User                  @relation("MaterialOrderCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  supplier          User                  @relation("MaterialOrderSupplier", fields: [supplierId], references: [id], onDelete: Restrict)
  inventoryLocation InventoryLocation     @relation(fields: [inventoryLocationId], references: [id], onDelete: Restrict)
  items             MaterialOrderItem[]
  events            MaterialOrderEvent[]
  paymentOrder      MaterialPaymentOrder?

  @@index([customerId, status, createdAt])
  @@index([supplierId, status, createdAt])
  @@index([inventoryLocationId, status])
}

model MaterialOrderItem {
  id                  String   @id
  orderId             String
  listingId           String
  stockId             String
  productNameSnapshot String   @db.VarChar(240)
  variantNameSnapshot String   @db.VarChar(240)
  sellerSkuSnapshot   String   @db.VarChar(160)
  unitNameSnapshot    String   @db.VarChar(80)
  quantity            Decimal  @db.Decimal(18, 3)
  unitPrice           Int
  lineTotal           Int
  createdAt           DateTime @default(now())

  order   MaterialOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  listing SupplierListing @relation(fields: [listingId], references: [id], onDelete: Restrict)
  stock   InventoryStock  @relation(fields: [stockId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([listingId, createdAt])
}

model MaterialOrderEvent {
  id        String                 @id
  orderId   String
  actorId   String?
  type      MaterialOrderEventType
  note      String?                @db.VarChar(2000)
  createdAt DateTime               @default(now())

  order MaterialOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor User?         @relation("MaterialOrderEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
}

model Notification {
  id        String           @id
  userId    String
  type      NotificationType
  title     String           @db.VarChar(180)
  body      String           @db.VarChar(1000)
  href      String?          @db.VarChar(500)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([userId, createdAt])
}

model MutationRateLimit {
  key       String   @id
  count     Int      @default(0)
  resetAt   DateTime
  updatedAt DateTime @default(now()) @updatedAt

  @@index([resetAt])
}

model MaterialPaymentOrder {
  id                 String        @id
  materialOrderId    String        @unique
  customerId         String
  supplierId         String
  amount             Int
  currency           String
  status             PaymentStatus @default(CREATED)
  idempotencyKey     String        @unique
  providerName       String?
  providerPaymentRef String?
  failureCode        String?
  failureMessage     String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @default(now()) @updatedAt
  cancelledAt        DateTime?

  materialOrder MaterialOrder @relation(fields: [materialOrderId], references: [id], onDelete: Restrict)
  customer      User          @relation("MaterialPaymentCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  supplier      User          @relation("MaterialPaymentSupplier", fields: [supplierId], references: [id], onDelete: Restrict)

  @@index([customerId, status])
  @@index([supplierId, status])
}

model CatalogModerationEvent {
  id              String   @id
  productId       String
  targetProductId String?
  actorId         String?
  action          String   @db.VarChar(40)
  note            String?  @db.VarChar(1000)
  metadata        Json     @default("{}")
  createdAt       DateTime @default(now())

  product       CatalogProduct  @relation("CatalogModerationProduct", fields: [productId], references: [id], onDelete: Restrict)
  targetProduct CatalogProduct? @relation("CatalogModerationTarget", fields: [targetProductId], references: [id], onDelete: SetNull)
  actor         User?           @relation("CatalogModerationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([productId, createdAt])
  @@index([targetProductId, createdAt])
  @@index([actorId, createdAt])
}
